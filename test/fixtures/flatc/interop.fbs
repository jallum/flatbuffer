file_identifier "EFBI";

enum Mood : byte {
  UNKNOWN,
  HAPPY,
  CURIOUS
}

struct Position {
  x: float;
  y: float;
  z: float;
}

struct ScalarMix {
  prefix: ubyte;
  wide: ulong;
  suffix: ushort;
}

struct NestedMix {
  flag: ubyte;
  value: ScalarMix;
  count: uint;
}

table Child {
  id: int;
  label: string;
}

table Root {
  active: bool;
  count: uint;
  score: double;
  mood: Mood;
  position: Position;
  name: string;
  values: [int];
  child: Child;
  scalar_mix: ScalarMix;
  scalar_mixes: [ScalarMix];
  nested_mix: NestedMix;
}

root_type Root;
