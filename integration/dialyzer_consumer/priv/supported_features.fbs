namespace dialyzer_consumer.supported;

file_identifier "SUPP";

enum Mood : short {
  UNKNOWN,
  HAPPY,
  CURIOUS
}

struct Pair {
  left: int;
  right: int;
}

struct NestedPair {
  pair: Pair;
  mood: Mood;
}

struct Padded {
  tag: ubyte;
  value: ulong;
  code: ushort;
}

table Child {
  id: int;
  label: string;
}

table Other {
  score: double;
}

union Payload {
  Child,
  Other
}

table Node {
  value: int;
  child: Node;
}

table Root {
  enabled: bool = true;
  count: uint;
  signed_byte: byte;
  unsigned_byte: ubyte;
  signed_short: short;
  unsigned_short: ushort;
  signed_int: int;
  signed_long: long;
  unsigned_long: ulong;
  ratio: float;
  score: double;
  mood: Mood = CURIOUS;
  moods: [Mood];
  title: string;
  numbers: [int];
  names: [string];
  padded: Padded;
  paddeds: [Padded];
  child: Child;
  children: [Child];
  payload: Payload;
  payloads: [Payload];
  node: Node;
  trailing: string;
  pair: Pair;
  nested_pair: NestedPair;
}

root_type Root;
